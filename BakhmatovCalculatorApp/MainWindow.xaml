<Window x:Class="BakhmatovCalculatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BakhmatovCalculatorApp"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="560"
        Width="980"
        Background="{Binding PageBackground}"
        PreviewTextInput="OnPreviewTextInput"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{Binding KeyBackground}"/>
            <Setter Property="Foreground" Value="{Binding KeyForeground}"/>
            <Setter Property="BorderBrush" Value="{Binding KeyBorderBrush}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Opacity="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{Binding HoverKeyBackground}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.96"
                                                             Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.02"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.02"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{Binding PressedKeyBackground}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.9"
                                                             Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.965"
                                                             Duration="0:0:0.06">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.965"
                                                             Duration="0:0:0.06">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Background" Value="{Binding AccentKeyBackground}"/>
            <Setter Property="Foreground" Value="{Binding AccentKeyForeground}"/>
            <Setter Property="BorderBrush" Value="{Binding AccentKeyBackground}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding HoverAccentKeyBackground}"/>
                    <Setter Property="BorderBrush" Value="{Binding HoverAccentKeyBackground}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{Binding PressedAccentKeyBackground}"/>
                    <Setter Property="BorderBrush" Value="{Binding PressedAccentKeyBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemeButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Opacity="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.82"/>
                                <Setter TargetName="RootBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="18" Background="{Binding PanelBackground}" BorderBrush="{Binding KeyBorderBrush}" BorderThickness="1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding WindowTitle}"
                           Foreground="{Binding KeyForeground}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           FontSize="18"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatButtonStyle}"
                            Command="{Binding ToggleLanguageCommand}"
                            Content="{Binding LanguageButtonText}"
                            Margin="0,0,10,0"
                            Height="36"
                            MinWidth="64"
                            FontSize="14"/>

                    <Button Style="{StaticResource ThemeButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"
                            Content="{Binding ThemeButtonText}"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="140"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        CornerRadius="18"
                        Background="{Binding PanelBackground}"
                        BorderBrush="{Binding KeyBorderBrush}"
                        BorderThickness="1">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding ExpressionLabelText}"
                                   Grid.Row="0"
                                   Foreground="{Binding SecondaryText}"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>

                        <TextBox Grid.Row="1"
                                 Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{Binding KeyForeground}"
                                 FontSize="22"
                                 HorizontalContentAlignment="Right"/>

                        <TextBlock Text="{Binding ResultLabelText}"
                                   Grid.Row="2"
                                   Foreground="{Binding SecondaryText}"
                                   FontSize="12"
                                   Margin="0,12,0,4"/>

                        <TextBox Grid.Row="2"
                                 Height="34"
                                 Margin="0,22,0,0"
                                 Text="{Binding ResultText}"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{Binding AccentKeyForeground}"
                                 FontSize="18"
                                 HorizontalContentAlignment="Right"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0 -->
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource FlatButtonStyle}" Command="{Binding ClearAllCommand}" Content="C"/>
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Command="{Binding ClearEntryCommand}" Content="CE"/>
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="^" Content="^"/>
                    <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="/" Content="/"/>

                    <!-- Row 1 -->
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource FlatButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="7" Content="7"/>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="8" Content="8"/>
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource FlatButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="9" Content="9"/>
                    <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="*" Content="*"/>

                    <!-- Row 2 -->
                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource FlatButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="4" Content="4"/>
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="5" Content="5"/>
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource FlatButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="6" Content="6"/>
                    <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="-" Content="-"/>

                    <!-- Row 3 -->
                    <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource FlatButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="1" Content="1"/>
                    <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="2" Content="2"/>
                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource FlatButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="3" Content="3"/>
                    <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="+" Content="+"/>

                    <!-- Row 4 -->
                    <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource FlatButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="0" Content="0"/>
                    <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Command="{Binding AppendCommand}" CommandParameter="." Content="."/>
                    <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Command="{Binding EvaluateCommand}" Content="="/>
                    <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource FlatButtonStyle}" Command="{Binding BackspaceCommand}" Content="&lt;-"/>
                </Grid>
            </Grid>

            <Border Grid.Column="1"
                    CornerRadius="18"
                    Background="{Binding PanelBackground}"
                    BorderBrush="{Binding KeyBorderBrush}"
                    BorderThickness="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding HistoryTitleText}"
                               Foreground="{Binding KeyForeground}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,4,0,10"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding HistoryItems}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.UseHistoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Expression}"
                                                   Foreground="{Binding DataContext.KeyForeground, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Result}"
                                                   Foreground="{Binding DataContext.SecondaryText, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        <TextBlock Text="{Binding Timestamp}"
                                                   Foreground="{Binding DataContext.SecondaryText, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
