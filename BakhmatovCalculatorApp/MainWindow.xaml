<Window x:Class="BakhmatovCalculatorApp.MainWindow"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:BakhmatovCalculatorApp.Infrastructure"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="620"
        Width="900"
        MinHeight="500"
        MinWidth="680"
        PreviewTextInput="OnPreviewTextInput"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>

        <!-- Общий шаблон с анимацией нажатия -->
        <infra:StringToBrushConverter x:Key="B"/>
        <ControlTemplate x:Key="AnimatedButtonTemplate" TargetType="Button">
            <Border x:Name="RootBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RootBorder" Property="Opacity" Value="0.82"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="RootBorder" Property="Opacity" Value="0.68"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="0.96" Duration="0:0:0.06">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="0.96" Duration="0:0:0.06">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.1">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.1">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Цифры -->
        <Style x:Key="NumButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{Binding KeyBackground, Converter={StaticResource B}}"/>
            <Setter Property="Foreground" Value="{Binding KeyForeground, Converter={StaticResource B}}"/>
            <Setter Property="Template" Value="{StaticResource AnimatedButtonTemplate}"/>
        </Style>

        <!-- Служебные: C, CE, xʸ, ⌫ -->
        <Style x:Key="FuncButtonStyle" TargetType="Button" BasedOn="{StaticResource NumButtonStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding SecondaryText, Converter={StaticResource B}}"/>
        </Style>

        <!-- Операторы: ÷ × − + -->
        <Style x:Key="OpButtonStyle" TargetType="Button" BasedOn="{StaticResource NumButtonStyle}">
            <Setter Property="Background" Value="{Binding AccentKeyBackground, Converter={StaticResource B}}"/>
            <Setter Property="Foreground" Value="{Binding AccentKeyForeground, Converter={StaticResource B}}"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <!-- Равно -->
        <Style x:Key="EqualButtonStyle" TargetType="Button" BasedOn="{StaticResource OpButtonStyle}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Маленькие кнопки тулбара -->
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource NumButtonStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Foreground" Value="{Binding KeyForeground, Converter={StaticResource B}}"/>
        </Style>

    </Window.Resources>
    <Border Background="{Binding PageBackground, Converter={StaticResource B}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: хедер + дисплей + клавиши -->
        <Grid Grid.Column="0" Margin="16,10,8,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="130"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Хедер: минималистичный -->
            <Grid Grid.Row="0">
                <TextBlock Text="{Binding WindowTitle}"
                           Foreground="{Binding SecondaryText, Converter={StaticResource B}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,2,0">
                    <Button Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding ToggleLanguageCommand}"
                            Content="{Binding LanguageButtonText}"
                            Margin="0,0,4,0"/>
                    <Button Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"
                            Content="{Binding ThemeButtonText}"/>
                </StackPanel>
            </Grid>

            <!-- Дисплей -->
            <Border Grid.Row="1"
                    CornerRadius="8"
                    Background="{Binding PanelBackground, Converter={StaticResource B}}">
                <Grid Margin="16,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="1"
                               Text="{Binding ExpressionLabelText}"
                               Foreground="{Binding SecondaryText, Converter={StaticResource B}}"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,2"/>

                    <TextBox Grid.Row="2"
                             Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{Binding SecondaryText, Converter={StaticResource B}}"
                             FontSize="22"
                             HorizontalContentAlignment="Right"
                             Margin="0,0,0,4"/>

                    <TextBox Grid.Row="3"
                             Text="{Binding ResultText}"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{Binding KeyForeground, Converter={StaticResource B}}"
                             FontSize="36"
                             FontWeight="Light"
                             HorizontalContentAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Клавиатура -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                    <!-- Строка 0: скобки + очистка -->
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource FuncButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="(" Content="(" Margin="3"/>
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource FuncButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter=")" Content=")" Margin="3"/>
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource FuncButtonStyle}"
        Command="{Binding ClearEntryCommand}" Content="CE" Margin="3"/>
                    <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource FuncButtonStyle}"
        Command="{Binding ClearAllCommand}" Content="C" Margin="3"/>

                    <!-- Строка 1: служебные + операторы -->
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource FuncButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="^" Content="xʸ" Margin="3"/>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource FuncButtonStyle}"
        Command="{Binding BackspaceCommand}" Content="⌫" FontSize="16" Margin="3"/>
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource OpButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="/" Content="÷" Margin="3"/>
                    <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource OpButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="*" Content="×" Margin="3"/>

                    <!-- Строка 2 -->
                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource NumButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="7" Content="7" Margin="3"/>
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource NumButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="8" Content="8" Margin="3"/>
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource NumButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="9" Content="9" Margin="3"/>
                    <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource OpButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="-" Content="−" Margin="3"/>

                    <!-- Строка 3 -->
                    <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource NumButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="4" Content="4" Margin="3"/>
                    <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource NumButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="5" Content="5" Margin="3"/>
                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource NumButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="6" Content="6" Margin="3"/>
                    <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource OpButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="+" Content="+" Margin="3"/>

                    <!-- Строка 4 -->
                    <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource NumButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="1" Content="1" Margin="3"/>
                    <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource NumButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="2" Content="2" Margin="3"/>
                    <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource NumButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="3" Content="3" Margin="3"/>
                    <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource NumButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="." Content="." Margin="3"/>

                    <!-- Строка 5 -->
                    <Button Grid.Row="5" Grid.Column="0" Style="{StaticResource NumButtonStyle}"
        Command="{Binding AppendCommand}" CommandParameter="0" Content="0" Margin="3"
        Grid.ColumnSpan="2"/>
                    <Button Grid.Row="5" Grid.Column="2" Style="{StaticResource EqualButtonStyle}"
        Command="{Binding EvaluateCommand}" Content="=" Margin="3"
        Grid.ColumnSpan="2"/>
                </Grid>
        </Grid>
        
    <!-- Правая колонка: история -->
        <Border Grid.Column="1"
                Background="{Binding PanelBackground, Converter={StaticResource B}}">
            <Grid Margin="14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding HistoryTitleText}"
                           Foreground="{Binding SecondaryText, Converter={StaticResource B}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding HistoryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,2"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{Binding DataContext.KeyBackground, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource B}}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.UseHistoryCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Expression}"
                                                   Foreground="{Binding DataContext.SecondaryText,
                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Result}"
                                                   Foreground="{Binding DataContext.KeyForeground,
                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Timestamp}"
                                                   Foreground="{Binding DataContext.SecondaryText,
                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>